{
    "name": "excelle-insights/sms",
    "description": "Multi-provider SMS package for Excelle applications",
    "type": "library",
    "license": "MIT",
    "keywords": ["sms", "africas-talking", "celcom", "excelle"],
    "authors": [
        {
            "name": "Excelle Insights",
            "email": "dev@excelleinsights.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "giggsey/libphonenumber-for-php-lite": "^8.13",
        "psr/log": "^3.0",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.22",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "ExcelleInsights\\Sms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExcelleInsights\\Sms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style-fix": "php-cs-fixer fix",
        "lint": "phpcs --standard=PSR12 src tests"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
